# Metardu Access — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# Sync server — implementing SYNC_API_CONTRACT.md
#
# For LOCAL DEVELOPMENT, use the mock sync server:
#   1. cd mock-sync-server && npm install && npm start
#   2. Find your LAN IP: ifconfig (Mac/Linux) or ipconfig (Windows)
#   3. Set the URLs below to http://<your-lan-ip>:8080/sync and /auth
#
# For PRODUCTION, point to the metardu web app's API:
EXPO_PUBLIC_SYNC_API_URL=http://localhost:8080/sync
EXPO_PUBLIC_SYNC_AUTH_URL=http://localhost:8080/auth

# Default country pack (KENYA = KEN, ARC 1960 / UTM 37S, EPSG:21037)
EXPO_PUBLIC_DEFAULT_COUNTRY_PACK=KEN
EXPO_PUBLIC_DEFAULT_CRS_EPSG=21037

# Sentry DSN (set in EAS environment for production)
EXPO_PUBLIC_SENTRY_DSN=

# App variant: development | staging | production
EXPO_PUBLIC_APP_VARIANT=development

# i18n
EXPO_PUBLIC_DEFAULT_LOCALE=en

# EAS
EAS_PROJECT_ID=
