# Metardu Access — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# Sync server — implementing SYNC_API_CONTRACT.md
# Default: metardu web's /api/sync endpoints (ArdhiSasa-validated)
EXPO_PUBLIC_SYNC_API_URL=https://metardu.duckdns.org/api/sync
EXPO_PUBLIC_SYNC_AUTH_URL=https://metardu.duckdns.org/api/auth

# Default country pack (KENYA = KEN, ARC 1960 / UTM 37S, EPSG:21037)
EXPO_PUBLIC_DEFAULT_COUNTRY_PACK=KEN
EXPO_PUBLIC_DEFAULT_CRS_EPSG=21037

# Sentry DSN (set in EAS environment for production)
EXPO_PUBLIC_SENTRY_DSN=

# App variant: development | staging | production
EXPO_PUBLIC_APP_VARIANT=development

# i18n
EXPO_PUBLIC_DEFAULT_LOCALE=en

# EAS
EAS_PROJECT_ID=
